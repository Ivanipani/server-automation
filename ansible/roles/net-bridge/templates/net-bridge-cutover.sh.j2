#!/bin/sh
{{ ansible_managed | comment }}
# Cut this host between the bridged and unbridged layouts already written to
# /etc/network/interfaces.
#
# Runs DETACHED (systemd-run --no-block), never from the SSH session: the first
# thing it does is tear down the interface that carries that session, so an
# in-session run would be killed halfway and leave the host with no address.
set -x

PORT={{ net_bridge.port }}
BR={{ net_bridge.name }}

# Release whatever holds the lease now. `ifdown` is driven by the NEW config
# file, so it cannot be trusted to know about the OLD layout — tear both
# candidates down by hand and flush the addresses instead.
ifdown "$BR" 2>/dev/null
ifdown "$PORT" 2>/dev/null
pkill -f "dhclient.*$BR" 2>/dev/null
pkill -f "dhclient.*$PORT" 2>/dev/null
ip addr flush dev "$BR" 2>/dev/null
ip addr flush dev "$PORT" 2>/dev/null

{% if net_bridge_enabled | bool %}
ip link set "$PORT" up
ifup "$BR"
{% else %}
# Reverse path: the bridge is gone from the config, so delete the device too —
# otherwise it lingers holding the port and `ifup $PORT` fails.
ip link set "$BR" down 2>/dev/null
ip link delete "$BR" type bridge 2>/dev/null
ifup "$PORT"
{% endif %}
